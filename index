let currentData = VOCAB_DATA;
 
// Populate set selector
const sel = document.getElementById('set-select');
VOCAB_DATA.forEach((s, i) => {
  const opt = document.createElement('option');
  opt.value = i;
  opt.textContent = s.label;
  sel.appendChild(opt);
});
 
function showAll() {
  sel.value = 'all';
  renderCards(VOCAB_DATA);
}
 
function applyFilter() {
  const v = sel.value;
  if (v === 'all') {
    renderCards(VOCAB_DATA);
  } else {
    renderCards([VOCAB_DATA[parseInt(v)]]);
  }
}
 
function renderCards(data) {
  const showCog = document.getElementById('opt-cognates').checked;
  const showTag = document.getElementById('opt-setlabel').checked;
  const grid = document.getElementById('card-grid');
  grid.innerHTML = '';
 
  let globalNum = 1;
  let totalCards = 0;
  let totalSets = 0;
 
  data.forEach(set => {
    if (!set.entries.length) return;
    totalSets++;
    totalCards += set.entries.length;
 
    const hdr = document.createElement('div');
    hdr.className = 'set-header';
    hdr.textContent = set.label;
    grid.appendChild(hdr);
 
    set.entries.forEach(entry => {
      const row = document.createElement('div');
      row.className = 'card-row';
 
      // FRONT card
      const front = document.createElement('div');
      front.className = 'card front';
      front.innerHTML = `
        <span class="card-num">#${globalNum}</span>
        ${showTag ? `<span class="card-set-tag">${set.label}</span>` : ''}
        <span class="heb-main">${entry.heb}</span>
      `;
 
      // BACK card
      const cogHtml = (showCog && entry.cognates.length) ? `
        <div class="cognates-label">Related words</div>
        ${entry.cognates.slice(0, 4).map(c => `
          <div class="cognate-item">
            <span class="cog-heb">${c.heb}</span>
            <span class="cog-def">${c.def}</span>
          </div>`).join('')}
      ` : '';
 
      const back = document.createElement('div');
      back.className = 'card back';
      back.innerHTML = `
        <span class="card-num">#${globalNum}</span>
        ${showTag ? `<span class="card-set-tag">${set.label}</span>` : ''}
        <div class="heb-main" style="font-size:1.1rem;margin-bottom:6px;text-align:right">${entry.heb}</div>
        <hr class="cut-line">
        <div class="def-text">${entry.def}</div>
        ${cogHtml}
      `;
 
      row.appendChild(front);
      row.appendChild(back);
      grid.appendChild(row);
      globalNum++;
    });
  });
 
  document.getElementById('stat-sets').textContent = totalSets;
  document.getElementById('stat-cards').textContent = totalCards;
}
 
// Initial render
renderCards(VOCAB_DATA);
 
// Re-render on option change
document.getElementById('opt-cognates').addEventListener('change', applyFilter);
document.getElementById('opt-setlabel').addEventListener('change', applyFilter);
