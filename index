<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Hebrew Vocabulary Flashcards – Print Edition</title>
<link href="https://fonts.googleapis.com/css2?family=Crimson+Pro:ital,wght@0,400;0,600;1,400&family=Noto+Sans+Hebrew:wght@400;700&family=IM+Fell+English+SC&display=swap" rel="stylesheet"/>
<style>
/* ── Screen styles ── */
:root {
  --ink: #1a1208;
  --paper: #faf6ee;
  --cream: #f2ead8;
  --amber: #8b5e2e;
  --gold: #c9943a;
  --rule: #d4c4a0;
  --faint: #e8dfc8;
  --heb-size: 2.2rem;
  --card-w: 3.5in;
  --card-h: 2.5in;
}
 
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
 
body {
  background: #e8e0d0;
  font-family: 'Crimson Pro', Georgia, serif;
  color: var(--ink);
  padding: 24px;
}
 
/* ── Screen UI controls ── */
.screen-ui {
  max-width: 900px;
  margin: 0 auto 32px;
  background: var(--paper);
  border: 1px solid var(--rule);
  border-radius: 4px;
  padding: 24px 28px;
  box-shadow: 0 2px 12px rgba(0,0,0,.12);
}
 
.screen-ui h1 {
  font-family: 'IM Fell English SC', serif;
  font-size: 1.7rem;
  letter-spacing: .06em;
  color: var(--amber);
  margin-bottom: 4px;
}
.screen-ui .subtitle {
  font-style: italic;
  color: #7a6545;
  font-size: .95rem;
  margin-bottom: 20px;
}
.stats {
  display: flex; gap: 24px; flex-wrap: wrap;
  margin-bottom: 20px;
  font-size: .88rem;
  color: #7a6545;
}
.stats strong { color: var(--amber); font-size: 1.1rem; }
 
.controls {
  display: flex; gap: 10px; flex-wrap: wrap; align-items: center;
  margin-bottom: 16px;
}
 
select {
  font-family: 'Crimson Pro', serif;
  font-size: .95rem;
  padding: 7px 12px;
  border: 1px solid var(--rule);
  border-radius: 3px;
  background: var(--cream);
  color: var(--ink);
  min-width: 220px;
  cursor: pointer;
}
 
button {
  font-family: 'IM Fell English SC', serif;
  font-size: .9rem;
  letter-spacing: .05em;
  padding: 8px 18px;
  border: 1px solid var(--amber);
  border-radius: 3px;
  background: var(--amber);
  color: var(--paper);
  cursor: pointer;
  transition: all .15s;
}
button:hover { background: #7a4f22; }
button.secondary {
  background: transparent;
  color: var(--amber);
}
button.secondary:hover { background: var(--faint); }
 
.options-row {
  display: flex; gap: 16px; flex-wrap: wrap;
  font-size: .9rem; color: #7a6545;
  align-items: center;
}
.options-row label { display: flex; align-items: center; gap: 6px; cursor: pointer; }
.options-row input[type=checkbox] { accent-color: var(--amber); width: 14px; height: 14px; }
 
.print-hint {
  margin-top: 14px;
  font-style: italic; font-size: .85rem; color: #999;
  border-top: 1px solid var(--rule);
  padding-top: 12px;
}
 
/* ── Card grid (screen preview) ── */
#card-grid {
  max-width: 900px;
  margin: 0 auto;
}
 
.set-header {
  font-family: 'IM Fell English SC', serif;
  font-size: 1rem;
  letter-spacing: .08em;
  color: var(--amber);
  margin: 28px 0 12px;
  padding-bottom: 6px;
  border-bottom: 1px solid var(--rule);
}
 
.card-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin-bottom: 12px;
}
 
/* ── Individual card ── */
.card {
  background: var(--paper);
  border: 1px solid var(--rule);
  border-radius: 3px;
  padding: 14px 16px;
  min-height: 110px;
  display: flex;
  flex-direction: column;
  position: relative;
  box-shadow: 0 1px 4px rgba(0,0,0,.08);
}
 
.card.front {
  align-items: center;
  justify-content: center;
  text-align: center;
  background: var(--paper);
}
 
.card.back {
  background: var(--cream);
  justify-content: space-between;
}
 
.card-num {
  position: absolute;
  top: 6px; left: 10px;
  font-size: .65rem;
  color: #bbb;
  letter-spacing: .06em;
  font-family: monospace;
}
 
.card-set-tag {
  position: absolute;
  top: 6px; right: 10px;
  font-size: .6rem;
  color: #c9aa7a;
  letter-spacing: .05em;
  font-style: italic;
  max-width: 45%;
  text-align: right;
  line-height: 1.3;
}
 
.heb-main {
  font-family: 'Noto Sans Hebrew', sans-serif;
  font-size: var(--heb-size);
  font-weight: 700;
  color: var(--ink);
  line-height: 1.2;
  direction: rtl;
}
 
.cut-line {
  border: none;
  border-top: 1px dashed #cbb98a;
  margin: 0 0 8px;
}
 
.def-text {
  font-size: .92rem;
  color: var(--ink);
  line-height: 1.45;
  flex: 1;
}
 
.cognates-label {
  font-size: .68rem;
  text-transform: uppercase;
  letter-spacing: .1em;
  color: #a08050;
  margin-top: 8px;
  margin-bottom: 3px;
}
 
.cognate-item {
  font-size: .8rem;
  color: #5a4020;
  display: flex;
  gap: 8px;
  align-items: baseline;
  line-height: 1.4;
}
 
.cog-heb {
  font-family: 'Noto Sans Hebrew', sans-serif;
  font-size: .95rem;
  direction: rtl;
  color: var(--amber);
  flex-shrink: 0;
}
 
.cog-def { font-style: italic; color: #7a6040; }
 
/* ── PRINT STYLES ── */
@media print {
  @page {
    size: letter;
    margin: 0.4in;
  }
 
  body {
    background: white;
    padding: 0;
    font-size: 11pt;
  }
 
  .screen-ui { display: none !important; }
  #card-grid { max-width: 100%; margin: 0; }
 
  .set-header {
    font-size: 9pt;
    margin: 18pt 0 8pt;
    color: #8b5e2e;
    page-break-after: avoid;
  }
 
  .card-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8pt;
    margin-bottom: 8pt;
    page-break-inside: avoid;
  }
 
  .card {
    border: 1px solid #c8b888;
    border-radius: 2pt;
    padding: 10pt 12pt;
    min-height: 0;
    box-shadow: none;
    page-break-inside: avoid;
    break-inside: avoid;
  }
 
  .card.front {
    min-height: 80pt;
  }
 
  .card.back {
    min-height: 80pt;
  }
 
  .heb-main {
    font-size: 24pt;
  }
 
  .def-text { font-size: 9pt; }
  .cog-heb { font-size: 9pt; }
  .cog-def { font-size: 8pt; }
  .cognates-label { font-size: 7pt; }
  .cognate-item { font-size: 8pt; }
  .card-num { font-size: 6pt; }
  .card-set-tag { font-size: 6pt; }
 
  /* Dashed cut lines between front/back pairs */
  .cut-line { border-top: 0.5pt dashed #aaa; }
}
</style>
</head>
